---
// Fonts must be JS imports here (not @import in global.css): @tailwindcss/postcss
// inlines CSS @imports without rebasing the packages' url(./files/*.woff2) refs,
// so Vite never emits the woff2. See tds-admin/AGENTS.md.
import "@fontsource/lato/400.css";
import "@fontsource/lato/700.css";
import "@fontsource/lato/900.css";
import "@fontsource-variable/plus-jakarta-sans";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import {
  CookieNotice,
  LiveChatCta,
  ThemeToggle,
  ToastHost,
} from "@tracht-digital-labs/tds-shared/components";
import { errorBounceScript, offscreenAnimationScript, themeBootstrapScript } from "@tracht-digital-labs/tds-shared/astro";
// Client-side navigation. See the CLIENT-SIDE NAVIGATION note further down for
// the four things it changes about how this shell has to be written.
import { ClientRouter } from "astro:transitions";
import Icon from "../components/Icon.astro";
import UserMenu from "../components/UserMenu.tsx";
import SetupBanner from "../components/SetupBanner.tsx";
import MobileTopBar from "../components/MobileTopBar.astro";
import NavDrawer from "../components/NavDrawer.astro";
import SidebarRail from "../components/SidebarRail.astro";
import QuickNav from "../components/QuickNav.tsx";
import AuthGate from "../components/AuthGate.astro";
import { baseNav } from "../lib/baseNav";
import { activeLabel, buildNavSections } from "../lib/navModel";
import { quickEntries } from "../lib/quickNav";
import { settingsSections } from "../lib/settingsSections";
import { registry } from "virtual:frontend-registry";
import { FRONTEND_TARGET } from "../config/target";
import { API_BASE } from "../lib/auth";

interface Props {
  title: string;
  description?: string;
  lang?: "de" | "en";
  /** Skip the gated chrome — used by /login itself. */
  bare?: boolean;
}

const {
  title,
  description = "Internes Panel: Tracht Digital Solutions.",
  lang = "de",
  bare = false,
} = Astro.props;

/**
 * SHELL ANATOMY — documented here rather than inline; see the gotcha below.
 *
 *   <AuthGate />          the pre-paint session gate in <head>; not on `bare` pages.
 *   <MobileTopBar />      below lg: drawer trigger, wordmark, page name, search,
 *                         theme and profile menu.
 *   <SidebarRail />       lg and up: the deep-navy rail with the collapse toggle.
 *   <NavDrawer />         below lg: the slide-in with the rail's surface.
 *   header.panel-topbar   lg and up: search, theme and profile menu.
 *   main#main             the page slot.
 *
 * The rail and the drawer both render `<NavList sections={navSections} />` and
 * `<BrandWordmark />`, so there is one source of truth for the MARKUP as well
 * as the data. They previously shared the data but hand-copied the markup, and
 * the copies had already drifted (only the rail set `data-nav`).
 *
 * CLIENT-SIDE NAVIGATION — the panel navigates with Astro's `ClientRouter`
 * (rendered in `<head>` below), so a nav click swaps the document instead of
 * reloading it: the rail, the top bar, the fonts and the stylesheet all stay
 * put, and the page never blanks. Four consequences this file has to honour,
 * each of which is a real bug if forgotten:
 *
 *  1. `<html>` LOSES EVERY ATTRIBUTE on a swap — Astro clears them and copies
 *     the incoming document's back. `data-surface`/`data-frontend` are
 *     server-rendered and come along; `data-theme` is written at runtime and
 *     would NOT, so the theme bootstrap re-applies it onto the incoming
 *     document (tds-shared 0.33.0). `auth-checking` being cleared is correct —
 *     the gate has already run.
 *  2. SCRIPTS RUN ONCE. Astro de-duplicates by `src` (module scripts) or by
 *     text content (inline ones), so nothing below re-executes by itself. Code
 *     that BINDS TO SHELL MARKUP must therefore rebind on `astro:page-load`,
 *     which fires on the initial load as well — that is what the init block at
 *     the end of the body does. Code that installs a one-time global (the
 *     401 backstop, the header provider, the notification poller) must NOT be
 *     in there, or every navigation would add another poller.
 *  3. CHROME THAT MUST NOT RESTART carries `transition:persist`: the toast
 *     stack (a toast raised by a save has to survive the navigation that
 *     follows it), the cookie notice (re-mounting it would re-animate the
 *     banner on every click) and the live-chat widget (an open conversation
 *     must not close because the user opened another page).
 *  4. THE PAGE STILL COSTS A SERVER RENDER. `mountNavProgress()` draws the
 *     thin bar that says so; without it a 300 ms swap reads as a dead click.
 *
 * GOTCHA — do NOT put a multi-line JSX expression comment in this file's
 * template body. Astro compiles the template into a template literal and
 * mis-parses it, failing the build with a bare `Expected ")" but found "{"`
 * that points at the comment's own closing line, not at anything real. Put
 * notes in frontmatter (like this) or use an HTML comment.
 */

// One resolved nav model (lib/navModel.ts), rendered by <NavList> in both the
// rail and the drawer, and flattened for the quick search. Active state and
// the section hue are resolved there, so NavList stays presentation only.
const navSections = buildNavSections(baseNav(FRONTEND_TARGET), registry.nav, Astro.url.pathname);
const quickNav = quickEntries(navSections, settingsSections(registry.settings));
// The mobile header names the page: below `lg` the rail is gone, and with it
// the only "you are here". The nav row's label is the short name; the title
// covers pages the nav does not list ("Profil", a ticket's detail page).
const pageLabel = activeLabel(navSections) ?? title.split(/\s[—–|]\s/)[0];

// The page swap. tds-shared turns the ROOT cross-fade off (the theme toggle
// animates root itself), so without this a navigation snapped. Only <main>
// fades — rail and top bar are identical on both sides and stay perfectly
// still. Astro's own keyframes, the design library's timing: the new page
// arrives at `--tds-dur-base`, the old one leaves faster. Reduced motion
// switches every view-transition animation off in tds-shared's base.css.
const pageSwap = {
  old: { name: "astroFadeOut", duration: "var(--tds-dur-fast)", easing: "var(--tds-ease-out)", fillMode: "both" },
  new: { name: "astroFadeIn", duration: "var(--tds-dur-base)", easing: "var(--tds-ease-out)", fillMode: "both" },
};
const mainTransition = { forwards: pageSwap, backwards: pageSwap };

// The shell wrapper is a flex COLUMN below lg (`flex flex-col lg:flex-row`),
// so the content column — and the tinted canvas on <main> — reaches the bottom
// of a short page. As a plain block it ended under the last card, and the rest
// of the phone screen was bare paper (2026-10-07).
---

<!DOCTYPE html>
<!-- data-surface selects the geometry layer from tds-shared's design library
     (surfaces/panel.css): the 8px product-UI geometry, 0.75rem chips and,
     since 0.15.0, a soft resting elevation.

     data-frontend selects the ACCENT within that layer, and is the only
     styling value FRONTEND_TARGET is allowed to drive: management reads the
     brand navy, the customer portal reads teal, so a user with both open
     knows at a glance which surface they are on. Everything else about the
     two products stays identical, one shell, one component set, one
     geometry. The accent is a single token block in surfaces/panel.css
     ([data-surface="panel"][data-frontend="customer"]); no component
     anywhere branches on the target. -->
<html lang={lang} data-surface="panel" data-frontend={FRONTEND_TARGET}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />

    {/* Where the composed API lives, for code that was built long before this
        product was. Every extension island calls the backend through
        tds-shared's `apiFetch`, which reads this — it cannot use
        `import.meta.env`, because it ships as a built package inside a
        consumer's node_modules and a PUBLIC_* substitution is not something a
        published package may rely on. Without it a relative call resolves
        against THIS static host, whose SPA fallback answers 200 + HTML: the
        island sees res.ok, json() throws, and the catch renders a calm empty
        state. That is what made the contact inbox report "Keine Anfragen." */}
    <meta name="tds-api-base" content={API_BASE} />

    {/* No-flash theme bootstrap — shared with the landingpage and the blog
        (tds-shared/astro). Must stay `is:inline` and must stay BEFORE the
        pre-paint auth gate below: the gate's spinner is painted in the theme's
        colours, so a theme applied after it would flash the wrong backdrop. */}
    <script is:inline set:html={themeBootstrapScript} />
    {/* Errors shake: a refused field, an alert or error toast appearing, the button that sent it (tds-shared). */}
    <script is:inline set:html={errorBounceScript} />
    {/* Endless animations rest while they are off screen (tds-shared >= 0.54). */}
    <script is:inline set:html={offscreenAnimationScript} />

    <link rel="preconnect" href="https://api.tracht-digital.de" crossorigin />
    <title>{title}</title>

    {/* Client-side navigation for the whole panel. Rendered unconditionally,
        `bare` included: a bare page is still reachable by link, and a router
        present on one page and absent on the next means the first click out of
        it falls back to a full load — which is correct behaviour but an odd
        thing to arrange on purpose.

        Prefetching is configured by `coreFrontendBase()` (astro.ts), not here:
        it is a build setting, and putting it in the integration keeps the
        product astro.configs free of anything but their extension set. */}
    <ClientRouter />

    {!bare && <AuthGate />}
  </head>
  <body>
    {
      bare ? (
        <slot />
      ) : (
        <div class="flex flex-col lg:flex-row min-h-dvh">
          <MobileTopBar pageLabel={pageLabel} />
          <SidebarRail navSections={navSections} />
          <NavDrawer navSections={navSections} />

          <!-- The rail's neighbour is a COLUMN, not the page itself: the top
               bar has to sit above the canvas and stick while it scrolls.
               `min-w-0` on the column is what keeps a wide table inside it
               from pushing the whole layout out: `body { overflow-x: hidden }`
               would then clip it silently rather than scrolling it. -->
          <div class="flex flex-col min-w-0 flex-1">
            <header class="panel-topbar hidden lg:flex">
              <button
                type="button"
                class="btn btn-ghost quick-nav-trigger"
                data-quick-nav-open
                aria-haspopup="dialog"
                aria-expanded="false"
                aria-keyshortcuts="Control+K Meta+K"
              >
                <Icon name="search" />
                <span>Suchen …</span>
                <kbd class="quick-nav-trigger__kbd" aria-hidden="true">Strg K</kbd>
              </button>
              <ThemeToggle client:idle />
              <UserMenu client:idle />
            </header>
            <main
              id="main"
              class="panel-main min-w-0 flex-1 p-4 sm:p-6 lg:px-10 lg:py-8"
              transition:name="tds-main"
              transition:animate={mainTransition}
            >
              <div class="mx-auto w-full max-w-[90rem]">
                {FRONTEND_TARGET === "admin" ? <SetupBanner client:only="react" /> : null}
                <slot />
              </div>
            </main>
          </div>
          <QuickNav client:idle entries={quickNav} />
        </div>
        <script>
          // ─── Per-page-load shell wiring ────────────────────────────────
          //
          // Everything in here binds to markup the ClientRouter REPLACES on
          // every navigation, so it has to run again each time. `astro:page-
          // load` fires on the initial load too, which is why there is no
          // separate first-run call — adding one would double-bind the very
          // first page.
          //
          // Anything that installs a one-time global belongs in the block
          // below this one, not here.
          import { initSidebarCollapse } from "../lib/sidebarCollapse";
          import { initNavDrawer } from "../lib/navDrawer";
          import { revealNav } from "../lib/revealNav";

          document.addEventListener("astro:page-load", () => {
            initNavDrawer();
            initSidebarCollapse();
            // Nav rows that depend on the principal (currently just "Meine
            // Firma"). Uses the memoised /me, so a re-run costs no request —
            // and it MUST re-run: the rows come back hidden with every fresh
            // server render.
            void revealNav();
          });
        </script>
        <script>
          // NB no `define:vars` on this script: it implies `is:inline`, and an
          // inline script is not bundled — these imports would reach the
          // browser as bare specifiers. The target is imported from the same
          // module the frontmatter uses instead.
          import {
            setRequestHeadersProvider,
            setUnauthorizedHandler,
          } from "@tracht-digital-labs/tds-shared/api";
          import { onUnauthorized } from "../lib/auth";
          import { actAsHeaders } from "../lib/activeCompany";
          import { initNotificationFeed } from "../lib/notificationFeed";
          import { initPreferences } from "../lib/preferences";
          import { mountNavProgress } from "@tracht-digital-labs/tds-shared/nav";
          import { FRONTEND_TARGET } from "../config/target";

          // Extension islands call the API through tds-shared's `apiFetch`,
          // which cannot reach into the host. Registering here is what finally
          // gives THEIR 401s the same backstop the host's own calls always had:
          // confirm against /me, try a refresh, and only then treat the session
          // as dead.
          setUnauthorizedHandler(onUnauthorized);

          // The active company rides on every COMPOSED-API call, so extension
          // islands read the tenant the user picked. The condition lives in
          // lib/activeCompany.ts with its own test — getting it wrong sends the
          // header to auth-api, whose CORS refuses it, and the login breaks.
          setRequestHeadersProvider(actAsHeaders);

          // The thin bar at the top of the viewport during a client-side
          // navigation. Mounted ONCE and driven by the router's own events.
          // Its server-rendered node below carries `transition:persist`, so the
          // body's replacement moves that SAME node into the incoming page;
          // putting the binding in the per-page block would stack listeners.
          mountNavProgress();

          // One poller for every composed module. Not in `bare` mode: the
          // login/gate page has no session to poll with.
          initNotificationFeed({ target: FRONTEND_TARGET });

          // Reconcile the theme with the user's SERVER-side preference and
          // push later changes back. localStorage stays the pre-paint cache
          // (the no-flash bootstrap in <head> reads it synchronously); this is
          // what makes the choice follow the user to another device. Runs
          // after the gate, and it is idempotent — a layout <script> executes
          // per page, and a second listener would double every save.
          initPreferences();
        </script>
      )
    }

    {/* The ONE toast stack for both products. Mounted unconditionally — also in
        `bare` mode, because the login/gate page is exactly where a failure has
        to be visible. Anything (island, plain module, console) reaches it via
        the `tds:toast` window event; a second host anywhere would double every
        toast, so this is the only place it may be mounted.

        `transition:persist` on all three: the router swaps <body>, and without
        it each of these would be torn down and re-mounted on every navigation.
        For the toast stack that is not cosmetic — a save that raises "Gespei-
        chert." and then navigates would destroy the toast before it was read,
        which is precisely the flow the CMS uses. The cookie notice would
        re-play its entrance animation on every click, and the chat widget would
        close an open conversation. */}
    {/* Server-rendered counterpart for mountNavProgress(). It must exist in
        both documents for Astro to persist the live node across a body swap;
        a dynamically appended bar with no incoming counterpart is discarded. */}
    <div
      id="tds-nav-progress"
      class="tds-nav-progress"
      data-state="idle"
      aria-hidden="true"
      transition:persist="tds-nav-progress"
    />
    <ToastHost client:idle lang={lang} transition:persist="tds-toast-host" />
    <CookieNotice client:idle variant="panel" transition:persist="tds-cookie-notice" />
    {/* Floating support widget — renders only when the live-chat-cta extension
        enables this frontend (admin/customer) in the admin Einstellungen. Same
        relative API base as every other panel call. */}
    {!bare && (
      <LiveChatCta
        client:idle
        frontend={FRONTEND_TARGET}
        lang={lang}
        transition:persist="tds-live-chat"
      />
    )}
  </body>
</html>
